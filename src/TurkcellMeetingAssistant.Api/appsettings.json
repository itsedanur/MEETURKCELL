{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AiSettings": {
    "Provider": "Mock",
    "OpenAiApiKey": "",
    "OpenAiModelName": "gpt-4o",
    "AzureOpenAiEndpoint": "https://your-resource-name.openai.azure.com/",
    "AzureOpenAiApiKey": "your-api-key",
    "AzureOpenAiDeploymentName": "gpt-4"
  },
  "SpeechToText": {
    "Provider": "Mock",
    "MaxFileSizeMb": 25,
    "AllowedExtensions": [".mp3", ".wav", ".m4a", ".mp4", ".webm", ".ogg"],
    "DefaultLanguage": "tr",
    "EnableChunking": false
  },
  "Email": {
    "Provider": "Mock",
    "DefaultSenderName": "Meeting Assistant",
    "DefaultSenderEmail": "no-reply@meetingassistant.local",
    "StoreEmailBody": true,
    "MaximumRecipientCount": 100,
    "AllowExternalRecipients": false,
    "AllowedEmailDomains": [
      "turkcell.com.tr",
      "meetingassistant.local"
    ],
    "EnableTestEmail": true,
    "MockFailureMode": false,
    "MockFailureRate": 0,
    "EmailFooterText": "Bu e-posta Meeting Assistant tarafından oluşturulmuştur."
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=turkcellmeetingassistant;Username=postgres;Password=YOUR_PASSWORD"
  },
  "JwtSettings": {
    "SecretKey": "super-secret-key-that-should-be-at-least-256-bits-long!",
    "Issuer": "TurkcellMeetingAssistant",
    "Audience": "TurkcellMeetingAssistantUsers",
    "AccessTokenExpirationMinutes": 60
  }
}
